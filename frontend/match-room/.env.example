# Copia este archivo como .env para desarrollo local.
# En Netlify estas variables se configuran en:
#   Site configuration > Environment variables

# URL base de la API, incluyendo el prefijo /api/v1.
# Si no se define, la aplicación usa http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Client ID de Google (Google Cloud Console > APIs & Services > Credentials).
# Sin este valor el botón de Google no funciona.
VITE_GOOGLE_CLIENT_ID=

# Habilita el acceso a la demostración (datos simulados) en builds de producción.
# En desarrollo, ?demo=1 ya la habilita. En Netlify se define en netlify.toml.
VITE_ENABLE_DEMO=false
